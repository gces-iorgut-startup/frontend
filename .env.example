# Google OAuth
VITE_GOOGLE_CLIENT_ID=
CALENDAR_API=
GOOGLE_CLIENT_ID=

# URL base da API.
# Deixe em branco para usar o padrão same-origin '/api' (recomendado): as
# chamadas passam pelo reverse proxy (nginx em prod, proxy do Vite em dev) e
# nunca disparam CORS. Defina apenas para apontar a uma API de outra origem.
# VITE_API_URL=/api

# Apenas para `npm run dev` (Vite): destino do proxy de /api.
# Padrão: http://localhost:3001 (porta publicada pelo docker-compose do backend).
# VITE_DEV_API_PROXY=http://localhost:3001

# E2E Tests
# URL do frontend em execução (ex.: http://localhost:5173)
BASE_URL=
# URL da API usada pelo E2E para criar/limpar dados (ex.: http://localhost:3000)
API_URL=
# true para rodar o Chrome sem janela (obrigatório no CI)
HEADLESS=false
# Segredo das rotas /test do backend: use o mesmo valor de E2E_TEST_SECRET do backend
E2E_TEST_SECRET=

# Smoke Tests de Produção (WEB-05 — npm run test:smoke:prod)
# URL pública HTTPS de produção (ex.: https://seu-dominio.com)
PROD_BASE_URL=
# Defina 'true' para exigir falha se /docs estiver exposto em produção
EXPECT_SWAGGER_DISABLED=true
# Defina 'true' para falhar caso as credenciais Canary de produção não sejam informadas
SMOKE_REQUIRE_CREDENTIALS=false
# Credenciais da clínica Canary em produção (nunca commite senhas reais neste arquivo)
PROD_SMOKE_OWNER_EMAIL=
PROD_SMOKE_OWNER_PASSWORD=
PROD_SMOKE_VET_EMAIL=
PROD_SMOKE_VET_PASSWORD=
PROD_SMOKE_TUTOR_EMAIL=
PROD_SMOKE_TUTOR_PASSWORD=

